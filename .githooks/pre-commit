#!/bin/sh
#
# 提交前安全检查（版本化，通过 core.hooksPath 生效）
# ============================================================
# 启用方式（克隆仓库后执行一次）：
#     git config core.hooksPath .githooks
#
# 检查逻辑见 scripts/check-commit.mjs，规则集中在那处维护。
#
# 注意：hook 由 Git 直接调起，不会经过用户的 shell 配置，
# 所以 node 可能不在这条进程的 PATH 里（Windows 上很常见）。
# 这里会尽力定位 node（PATH → KANBAN_NODE → WorkBuddy 自带）。
#
# 🔴 2026-09-16 改（审计 P2 / C-M2）：**定位不到 node 就拒绝提交**，不再静默放行。
#    原先找不到 node 会 `exit 0` 并打印一条提示 —— 出发点是"别卡死所有提交"，
#    但代价是这道闸**可以无声失效**（提交照常成功，而检查一次都没跑）。
#    「门禁静默失效」比「门禁不可用」危险得多：前者会给人"已覆盖"的错觉。
#    现在改为 fail-closed：提示里给出两条出路（装 node / 设 KANBAN_NODE）
#    与显式绕过方式（--no-verify）；CI 另有一道 `check-commit --all` 兜底。

# ---- 定位 node ----
NODE_BIN=""

if command -v node >/dev/null 2>&1; then
  NODE_BIN="node"
fi

if [ -z "$NODE_BIN" ] && [ -n "$KANBAN_NODE" ] && [ -x "$KANBAN_NODE" ]; then
  NODE_BIN="$KANBAN_NODE"
fi

if [ -z "$NODE_BIN" ]; then
  # WorkBuddy 自带的 node（Windows: node.exe，类 Unix: node）
  for d in "$HOME"/.workbuddy/binaries/node/versions/*/ ; do
    if [ -x "$d/node.exe" ]; then NODE_BIN="$d/node.exe"; break; fi
    if [ -x "$d/node" ]; then NODE_BIN="$d/node"; break; fi
  done
fi

if [ -z "$NODE_BIN" ]; then
  echo ""
  echo "──────────────────────────────────────────────"
  echo " ❌ 未找到 node —— **拒绝提交**（提交前检查无法运行）"
  echo ""
  echo " 为什么不是「跳过检查后放行」："
  echo "   那会让这道闸**静默失效** —— 提交看起来成功，实际什么都没检查。"
  echo "   本项目的密钥 / 大文件 / 本机路径检查全在 scripts/check-commit.mjs，"
  echo "   跳过它等于裸奔。"
  echo ""
  echo " 怎么修（任选其一）："
  echo "   1) 把 node 加入 PATH"
  echo "   2) export KANBAN_NODE=/path/to/node   （本 hook 会优先用它）"
  echo ""
  echo " 确认这次确实要绕过（自行承担风险）："
  echo "   git commit --no-verify"
  echo "   ⚠️ CI 里另有一道 check-commit --all，绕过本地这关也会在那里被拦下。"
  echo "──────────────────────────────────────────────"
  exit 1
fi

# ---- 运行检查 ----
"$NODE_BIN" scripts/check-commit.mjs
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "──────────────────────────────────────────────"
  echo " 提交已被阻止（安全问题或误提交风险）"
  echo " 修正后可重新提交；确需跳过时用：git commit --no-verify"
  echo "──────────────────────────────────────────────"
  exit 1
fi

exit 0
